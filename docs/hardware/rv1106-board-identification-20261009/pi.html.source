      <div class="container-lg my-4">
      <div class="row">
        <div class="col gx-0 gx-lg-4">
          <ul class="nav nav-underline border rounded-2 rounded-bottom-0">
            <li class="nav-item fs-6 ms-3"><a class="nav-link py-3 active" href="#tab-description" data-bs-toggle="tab">Description</a></li>
                        <li class="nav-item fs-6"><a class="nav-link py-3" href="#tab-specification" data-bs-toggle="tab">Specification</a></li>
