</td>
<td colspan="1">Arduino uno
</td></tr>
<tr align="center">
<td>VCC</td>
<td>5V
</td></tr>
<tr align="center">
<td>GND</td>
<td>GND
</td></tr>
<tr align="center">
<td>LCD_DIN</td>
<td>11
</td></tr>
<tr align="center">
<td>LCD_CLK</td>
<td>13
</td></tr>
<tr align="center">
<td>LCD_CS</td>
<td>10
</td></tr>
<tr align="center">
<td>LCD_DC</td>
<td>7
</td></tr>
<tr align="center">
<td>LCD_RST</td>
<td>8
</td></tr>
<tr align="center">
<td>LCD_BL</td>
<td>9
</td></tr>
<tr align="center">
<td>TP_SDA</td>
<td>SDA
</td></tr>
<tr align="center">
<td>TP_SCL</td>
<td>SCL
</td></tr>
<tr align="center">
<td>TP_RST</td>
