<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Teamo · 运动图标方案对比 v2(A-I 九组)</title><style>
:root{font-family:Inter,'Noto Sans SC',sans-serif;color:#eef2f5}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at 50% -20%,#26313a 0,#131a20 43%,#0d1216 100%);min-height:100vh;padding:36px 5vw 90px}
h1{font-size:25px;margin:0 0 6px} .sub{color:#8f9aa4;font-size:13px;margin:0 0 18px;line-height:1.8}
.sub b{color:#c6ff45}
nav.top{position:sticky;top:0;z-index:9;display:flex;gap:8px;flex-wrap:wrap;padding:10px 0;background:linear-gradient(#0d1216f0,#0d121600);margin-bottom:8px}
nav.top a{padding:7px 14px;border:1px solid #2e3840;border-radius:16px;color:#aab4bd;font-size:12px;text-decoration:none}
nav.top a:hover{border-color:#c6ff45;color:#c6ff45}
.note{border-left:3px solid #c6ff45;padding:10px 16px;color:#aab4bd;font-size:13px;line-height:1.8;margin-bottom:26px}
.scheme{border:1px solid #2a3137;border-radius:22px;background:#11161a;padding:26px 28px;margin-bottom:26px;scroll-margin-top:60px}
.scheme header{display:flex;align-items:baseline;gap:14px;margin-bottom:20px;flex-wrap:wrap}
.scheme header b{font-size:19px} .scheme header small{color:#7f8a91;font-size:12.5px}
.sports{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.sp{border:1px solid #262e35;border-radius:16px;background:#151b20;padding:20px 10px 14px;display:grid;justify-items:center;gap:6px;text-align:center}
.sp.paper{background:#f5f0e2;border-color:#d8d0bc} .sp.paper b{color:#3a3226} .sp.paper small{color:#8a7f68} .sp.paper em{color:#7a6f5a}
.sp-ico{width:64px;height:64px;display:grid;place-items:center;color:#c6ff45}
.sp.paper .sp-ico{color:#4a3f2d}
.sp-ico svg{width:54px;height:54px}
.sp b{font-size:14.5px} .sp small{font-size:10px;color:#5f6b74;word-break:break-all} .sp em{font-style:normal;font-size:11px;color:#7f8a91}
.ctx{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.sim{border:1px dashed #2e3840;border-radius:16px;padding:16px;display:grid;gap:12px;justify-items:center}
.sim>small{color:#8f9aa4;font-size:12px} .sim .dim{color:#5f6b74}
.paper-bg{background:#efe8d5;border-color:#d8d0bc} .paper-bg .sim{border-color:#c9bfa5} .paper-bg .sim>small{color:#8a7f68}
.paper-bg .sp-ico,.paper-bg .sim-choice,.paper-bg .sim-tabs .on{color:#6b4f2a}
.paper2{background:#f5f0e2!important;color:#4a3f2d!important;border:0!important}
.sim-tabs{display:flex;gap:22px;color:#69747c}
.sim-tabs span svg{width:26px;height:26px;display:block}
.sim-tabs span.on{color:#c6ff45}
.sim-choice{width:76px;height:76px;border:3px solid #c6ff45;border-radius:50%;display:grid;place-items:center;color:#c6ff45}
.sim-choice svg{width:38px;height:38px}
.sim-menu{display:grid;grid-template-columns:repeat(2,64px);gap:10px}
.sim-menu span{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#222a30;color:#eef2f5}
.sim-menu span:first-child{color:#c6ff45;border:3px solid #c6ff45;background:transparent}
.sim-menu svg{width:30px;height:30px}
svg.ic{width:48px;height:48px}
svg.pix{image-rendering:pixelated}
.miss{color:#e8b93c;font-size:10px}
/* G 配色 */
.theme{display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:center;margin-bottom:12px}
.tname b{font-size:14px;display:block} .tname small{color:#5f6b74;font-size:10.5px}
.tchip{border-radius:14px;padding:14px 18px;display:grid;gap:10px}
.trow{display:flex;gap:26px;align-items:center}
.trow span svg{width:26px;height:26px;display:block}
/* H 手机端 */
.phone-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}
.ph-ic{border:1px solid #262e35;border-radius:12px;background:#151b20;padding:12px 6px;display:grid;justify-items:center;gap:6px}
.ph-ic svg{width:24px;height:24px;color:#c6ff45} .ph-ic b{font-size:11px;color:#aab4bd;font-weight:500}
.sim-phone{width:min(320px,100%);border:1px solid #2e3840;border-radius:26px;background:#0b0f13;padding:14px;display:grid;gap:10px;margin:auto}
.ph-top{display:flex;align-items:center;gap:9px;color:#eef2f5;font-size:14px}
.ph-top svg{color:#c6ff45} .ph-top b{flex:1;text-align:left}
.ph-card{display:flex;align-items:center;gap:10px;border:1px solid #262e35;border-radius:13px;background:#151b20;padding:11px 12px;font-size:13px}
.ph-card div{flex:1;text-align:left} .ph-card small{display:block;color:#7f8a91;font-size:11px}
.ph-cta{border:0;border-radius:22px;background:#c6ff45;color:#11170a;font-weight:700;padding:12px;font-size:14px;display:flex;gap:8px;align-items:center;justify-content:center}
.ph-check{display:flex;gap:14px;color:#7f8a91;font-size:11.5px;align-items:center}
.ph-check svg{width:15px;height:15px;color:#c6ff45}
svg.ic2{width:17px;height:17px} svg.ic3{width:30px;height:30px;color:#c6ff45}
@media(max-width:900px){.sports{grid-template-columns:repeat(2,1fr)}.ctx{grid-template-columns:1fr}.phone-grid{grid-template-columns:repeat(4,1fr)}.theme{grid-template-columns:1fr}}
</style></head><body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
<symbol id="tabler-jump-rope" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M6 14V8a3 3 0 1 1 6 0v8a3 3 0 0 0 6 0v-6"/><path d="M16 5a2 2 0 0 1 2-2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2a2 2 0 0 1-2-2zM4 16a2 2 0 0 1 2-2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2a2 2 0 0 1-2-2z"/></g></symbol><symbol id="tabler-run" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M11.007 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M4 17l5 1l.75-1.5M15 21v-4l-4-3l1-6"/><path d="M7 12V9l5-1l3 3l3 1"/></g></symbol><symbol id="tabler-walk" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 4a1 1 0 1 0 2 0a1 1 0 1 0-2 0M7 21l3-4m6 4l-2-4l-3-3l1-6"/><path d="m6 12l2-3l4-1l3 3l3 1"/></g></symbol><symbol id="tabler-barbell" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h1m3-4H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2m0-9v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1m3 5h6m0-5v10a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1m3 1h2a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2m4-4h-1"/></symbol><symbol id="tabler-dumbbell" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m7.026 9.61l-.95-4.18A2 2 0 0 1 8.026 3h8a2 2 0 0 1 2 2.43l-1 4.2m-8 7.371h6"/><path d="M18.906 20.06a7.92 7.92 0 0 0 1-5.33a8 8 0 1 0-14.77 5.33a2 2 0 0 0 1.71.94h10.36a2 2 0 0 0 1.7-.94"/></g></symbol><symbol id="tabler-stretching" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5a1 1 0 1 0 2 0a1 1 0 1 0-2 0M5 20l5-.5l1-2m7 2.5v-5h-5.5L15 8.5l-5.5 1l1.5 2"/></symbol><symbol id="tabler-stretching-2" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6.5 21l3.5-5m-5-5l7-2m4 12l-4-7V9l7-4M9.007 6a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/></symbol><symbol id="tabler-trophy" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4-4v4M7 4h10m0 0v8a5 5 0 0 1-10 0V4M3 9a2 2 0 1 0 4 0a2 2 0 1 0-4 0m14 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/></symbol><symbol id="tabler-settings" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37c1 .608 2.296.07 2.572-1.065"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/></g></symbol><symbol id="tabler-heartbeat" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M19.5 13.572L12 21l-2.896-2.868m-6.117-8.104A5 5 0 0 1 12 7.006a5 5 0 1 1 7.5 6.572"/><path d="M3 13h2l2 3l2-6l1 3h3"/></g></symbol><symbol id="tabler-activity" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h4l3 8l4-16l3 8h4"/></symbol><symbol id="tabler-yoga" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 20h4l1.5-3m7.5 3l-1-5h-5l1-7"/><path d="m4 10l4-1l4-1l4 1.5l4 1.5m-9.993-6a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/></g></symbol><symbol id="tabler-treadmill" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 3a1 1 0 1 0 2 0a1 1 0 0 0-2 0M3 14l4 1l.5-.5M12 18v-3l-3-2.923L9.75 7"/><path d="M6 10V8l4-1l2.5 2.5l2.5.5m6 12a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1m15-1l1-11l2-1"/></g></symbol><symbol id="tabler-user" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0-8 0M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></symbol><symbol id="tabler-bell" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3H4a4 4 0 0 0 2-3v-3a7 7 0 0 1 4-6M9 17v1a3 3 0 0 0 6 0v-1"/></symbol><symbol id="tabler-calendar" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm12-4v4M8 3v4m-4 4h16m-9 4h1m0 0v3"/></symbol><symbol id="tabler-clock" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0"/><path d="M12 7v5l3 3"/></g></symbol><symbol id="tabler-share" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0m12-6a3 3 0 1 0 6 0a3 3 0 1 0-6 0m0 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0m-6.3-7.3l6.6-3.4m-6.6 6l6.6 3.4"/></symbol><symbol id="tabler-home" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12H3l9-9l9 9h-2M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/><path d="M9 21v-6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v6"/></g></symbol><symbol id="tabler-circle-check" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0"/><path d="m9 12l2 2l4-4"/></g></symbol><symbol id="tabler-chevron-right" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 6l6 6l-6 6"/></symbol><symbol id="tabler-heart" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 12.572L12 20l-7.5-7.428A5 5 0 1 1 12 6.006a5 5 0 1 1 7.5 6.572"/></symbol><symbol id="tabler-moon" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3h.393a7.5 7.5 0 0 0 7.92 12.446A9 9 0 1 1 12 2.992z"/></symbol><symbol id="tabler-plus" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/></symbol><symbol id="tabler-send" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14L21 3m0 0l-6.5 18a.55.55 0 0 1-1 0L10 14l-7-3.5a.55.55 0 0 1 0-1z"/></symbol><symbol id="tabler-stopwatch" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13a7 7 0 1 0 14 0a7 7 0 0 0-14 0m9.5-2.5L12 13m5-5l1-1m-4-4h-4"/></symbol><symbol id="tabler-flame" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10.941c2.333-3.308.167-7.823-1-8.941c0 3.395-2.235 5.299-3.667 6.706C5.903 10.114 5 12 5 14.294C5 17.998 8.134 21 12 21s7-3.002 7-6.706c0-1.712-1.232-4.403-2.333-5.588c-2.084 3.353-3.257 3.353-4.667 2.235"/></symbol><symbol id="mingcute-squats-line" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21h-1l2.255-4.135a1 1 0 0 0-.806-1.476l-3.094-.221M11 9.435l3.5 1.065L18 10m-5-5a2 2 0 1 1-4 0a2 2 0 0 1 4 0M8.983 1