digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_sync_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">在线</TD></TR><TR><TD WIDTH="99" HEIGHT="20">快照已确认</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_sync_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">断网</TD></TR><TR><TD WIDTH="144" HEIGHT="20">家长显示上次确认</TD></TR></TABLE>>,];
n2 [id="node_sync_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">本地继续</TD></TR><TR><TD WIDTH="114" HEIGHT="20">运动安全继续</TD></TR></TABLE>>,];
n3 [id="node_sync_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">待上传</TD></TR><TR><TD WIDTH="99" HEIGHT="20">已可靠保存</TD></TR></TABLE>>,];
n4 [id="node_sync_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">上传中</TD></TR><TR><TD WIDTH="114" HEIGHT="20">同幂等键重试</TD></TR></TABLE>>,];
n5 [id="node_sync_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">待确认</TD></TR><TR><TD WIDTH="129" HEIGHT="20">接收确认未到达</TD></TR></TABLE>>,];
n6 [id="node_sync_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">已同步</TD></TR><TR><TD WIDTH="114" HEIGHT="20">清理确认队列</TD></TR></TABLE>>,];
n7 [id="node_sync_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">重连校准</TD></TR><TR><TD WIDTH="129" HEIGHT="20">序号缺口取快照</TD></TR></TABLE>>,];
n8 [id="node_sync_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">删除墓碑</TD></TR><TR><TD WIDTH="114" HEIGHT="20">阻止缓存复活</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">网络断开</TD></TR></TABLE>>,id="edge_0_1_0",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">本地运动</TD></TR></TABLE>>,id="edge_1_2_1",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">保存结果</TD></TR></TABLE>>,id="edge_2_3_2",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">联网上传</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">服务收到</TD></TR></TABLE>>,id="edge_4_5_4",];
n5 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">确认收到</TD></TR></TABLE>>,id="edge_5_6_5",];
n5 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">确认丢失重试</TD></TR></TABLE>>,id="edge_5_4_6",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n1 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">连接恢复</TD></TR></TABLE>>,id="edge_1_7_7",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n7 -> n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">快照校准</TD></TR></TABLE>>,id="edge_7_0_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n3 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">授权删除</TD></TR></TABLE>>,id="edge_3_8_9",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];}