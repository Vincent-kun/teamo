digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_growth_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">待机陪伴</TD></TR><TR><TD WIDTH="84" HEIGHT="20">低打扰</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_growth_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">运动鼓励</TD></TR><TR><TD WIDTH="99" HEIGHT="20">提醒有冷却</TD></TR></TABLE>>,];
n2 [id="node_growth_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">结果已保存</TD></TR><TR><TD WIDTH="99" HEIGHT="20">真实努力</TD></TR></TABLE>>,];
n3 [id="node_growth_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">奖励待发</TD></TR><TR><TD WIDTH="99" HEIGHT="20">按会话唯一</TD></TR></TABLE>>,];
n4 [id="node_growth_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">奖励已发</TD></TR><TR><TD WIDTH="84" HEIGHT="20">幂等去重</TD></TR></TABLE>>,];
n5 [id="node_growth_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">个人进步</TD></TR><TR><TD WIDTH="99" HEIGHT="20">有可比依据</TD></TR></TABLE>>,];
n6 [id="node_growth_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">未完成反馈</TD></TR><TR><TD WIDTH="99" HEIGHT="20">不羞辱儿童</TD></TR></TABLE>>,];
n7 [id="node_growth_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">角色偏好</TD></TR><TR><TD WIDTH="84" HEIGHT="20">年龄语气</TD></TR></TABLE>>,];
n8 [id="node_growth_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">安静模式</TD></TR><TR><TD WIDTH="84" HEIGHT="20">克制邀请</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">开始运动</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">保存结果</TD></TR></TABLE>>,id="edge_1_2_1",];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">规则产生奖励</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">去重发放</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">历史比较</TD></TR></TABLE>>,id="edge_4_5_4",];
n2 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">提前结束</TD></TR></TABLE>>,id="edge_2_6_5",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n0 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">选择偏好</TD></TR></TABLE>>,id="edge_0_7_6",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n0 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">安静设置</TD></TR></TABLE>>,id="edge_0_8_7",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];}