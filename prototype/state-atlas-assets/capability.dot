digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=LR; edge [arrowhead=none]; root [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">运动伙伴</TD></TR><TR><TD WIDTH="144" HEIGHT="20">完整软件能力范围</TD></TR></TABLE>>,fillcolor="#e8def8",penwidth=2];g0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">运动执行</TD></TR></TABLE>>,fillcolor="#f7f5fa"];root->g0;session [id="map_session",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">运动主状态</TD></TR><TR><TD WIDTH="114" HEIGHT="20">设备会话模块</TD></TR></TABLE>>];g0->session;algorithm [id="map_algorithm",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">动作与入镜</TD></TR><TR><TD WIDTH="129" HEIGHT="20">视觉算法适配器</TD></TR></TABLE>>];g0->algorithm;task [id="map_task",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="186" HEIGHT="20">任务与计划</TD></TR><TR><TD WIDTH="186" HEIGHT="20">发布方配置 + 设备执行</TD></TR></TABLE>>];g0->task;g1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">家庭管理</TD></TR></TABLE>>,fillcolor="#f7f5fa"];root->g1;binding [id="map_binding",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="171" HEIGHT="20">账号与设备绑定</TD></TR><TR><TD WIDTH="171" HEIGHT="20">家长身份 + 设备归属</TD></TR></TABLE>>];g1->binding;privacy [id="map_privacy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="171" HEIGHT="20">采集与隐私</TD></TR><TR><TD WIDTH="171" HEIGHT="20">物理状态 + 家长授权</TD></TR></TABLE>>];g1->privacy;sync [id="map_sync",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="171" HEIGHT="20">网络与结果同步</TD></TR><TR><TD WIDTH="171" HEIGHT="20">设备记录 + 接收确认</TD></TR></TABLE>>];g1->sync;g2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">反馈与扩展</TD></TR></TABLE>>,fillcolor="#f7f5fa"];root->g2;growth [id="map_growth",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">陪伴与成长</TD></TR><TR><TD WIDTH="144" HEIGHT="20">真实运动记录派生</TD></TR></TABLE>>];g2->growth;analysis [id="map_analysis",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="171" HEIGHT="20">分析与训练计划</TD></TR><TR><TD WIDTH="171" HEIGHT="20">授权摘要 + 规则审核</TD></TR></TABLE>>];g2->analysis;posture [id="map_posture",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">学习体态提醒</TD></TR><TR><TD WIDTH="114" HEIGHT="20">独立采集模式</TD></TR></TABLE>>];g2->posture;school [id="map_school",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="201" HEIGHT="20">学校任务与权限</TD></TR><TR><TD WIDTH="201" HEIGHT="20">学校发布 + 家长独立授权</TD></TR></TABLE>>];g2->school;g3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">运行保障</TD></TR></TABLE>>,fillcolor="#f7f5fa"];root->g3;maintenance [id="map_maintenance",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">设备故障与升级</TD></TR><TR><TD WIDTH="129" HEIGHT="20">设备运行与版本</TD></TR></TABLE>>];g3->maintenance;}