n8 [id="node_maintenance_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="93" HEIGHT="20">成功/回滚</TD></TR><TR><TD WIDTH="93" HEIGHT="20">记录保留</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">自检通过</TD></TR></TABLE>>,id="edge_0_1_0",];
