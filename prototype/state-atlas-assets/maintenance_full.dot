n4 [id="node_maintenance_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">异常重启</TD></TR><TR><TD WIDTH="114" HEIGHT="20">保留确认事实</TD></TR></TABLE>>,];
n5 [id="node_maintenance_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">恢复暂停</TD></TR><TR><TD WIDTH="84" HEIGHT="20">重新入镜</TD></TR></TABLE>>,];
