n1 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">意外断电</TD></TR></TABLE>>,id="edge_1_4_3",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
