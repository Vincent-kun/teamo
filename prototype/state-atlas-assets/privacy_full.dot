digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_privacy_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">物理关闭</TD></TR><TR><TD WIDTH="84" HEIGHT="20">禁止采集</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_privacy_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">授权待确认</TD></TR><TR><TD WIDTH="99" HEIGHT="20">用途透明</TD></TR></TABLE>>,];
n2 [id="node_privacy_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">允许采集</TD></TR><TR><TD WIDTH="144" HEIGHT="20">物理与授权均满足</TD></TR></TABLE>>,];
n3 [id="node_privacy_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">采集中</TD></TR><TR><TD WIDTH="114" HEIGHT="20">工作状态可见</TD></TR></TABLE>>,];
n4 [id="node_privacy_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">状态未知</TD></TR><TR><TD WIDTH="114" HEIGHT="20">默认安全停采</TD></TR></TABLE>>,];
n5 [id="node_privacy_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">权限撤销</TD></TR><TR><TD WIDTH="114" HEIGHT="20">停止采集分析</TD></TR></TABLE>>,];
n6 [id="node_privacy_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">删除请求</TD></TR><TR><TD WIDTH="129" HEIGHT="20">记录队列与分析</TD></TR></TABLE>>,];
n7 [id="node_privacy_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">删除完成</TD></TR><TR><TD WIDTH="129" HEIGHT="20">阻止旧缓存补传</TD></TR></TABLE>>,];
n8 [id="node_privacy_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">重新授权</TD></TR><TR><TD WIDTH="114" HEIGHT="20">仍需物理允许</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">请求授权</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">授权且物理开启</TD></TR></TABLE>>,id="edge_1_2_1",];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="123" HEIGHT="20">进入运动/学习</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">物理关闭</TD></TR></TABLE>>,id="edge_3_0_3",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">读取状态失败</TD></TR></TABLE>>,id="edge_3_4_4",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n3 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">授权撤销</TD></TR></TABLE>>,id="edge_3_5_5",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n5 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">家长另行删除</TD></TR></TABLE>>,id="edge_5_6_6",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n6 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">删除与同步完成</TD></TR></TABLE>>,id="edge_6_7_7",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n5 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">重新授权</TD></TR></TABLE>>,id="edge_5_8_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n8 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">物理状态允许</TD></TR></TABLE>>,id="edge_8_2_9",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];}