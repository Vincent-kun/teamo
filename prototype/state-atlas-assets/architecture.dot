digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=LR; subgraph cluster_parent {label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="171" HEIGHT="20">家长端 · 任务与结果</TD></TR></TABLE>>;color="#dfd7eb";style=rounded; parent [id="arch_task",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="174" HEIGHT="20">任务与授权</TD></TR><TR><TD WIDTH="174" HEIGHT="20">家长选择、创建、查看</TD></TR></TABLE>>];}
subgraph cluster_data {label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="248" HEIGHT="20">同步与数据职责 · 部署待M1评审</TD></TR></TABLE>>;color="#dfd7eb";style=rounded; gateway [id="arch_sync",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="159" HEIGHT="20">同步与权限</TD></TR><TR><TD WIDTH="159" HEIGHT="20">命令回执、访问隔离</TD></TR></TABLE>>]; records [id="arch_analysis",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">结构化运动记录</TD></TR><TR><TD WIDTH="144" HEIGHT="20">摘要、分析、成长</TD></TR></TABLE>>];}
subgraph cluster_device {label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="156" HEIGHT="20">设备端 · 运动当下</TD></TR></TABLE>>;color="#c6dacf";style=rounded; session [id="arch_session",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="174" HEIGHT="20">运动会话</TD></TR><TR><TD WIDTH="174" HEIGHT="20">计数、暂停、恢复真源</TD></TR></TABLE>>,fillcolor="#e8f3ee"]; camera [id="arch_privacy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="204" HEIGHT="20">视觉与物理隐私</TD></TR><TR><TD WIDTH="204" HEIGHT="20">允许采集、入镜、有效事件</TD></TR></TABLE>>]; feedback [id="arch_growth",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">屏幕与语音</TD></TR><TR><TD WIDTH="144" HEIGHT="20">进度、引导、鼓励</TD></TR></TABLE>>]; local [id="arch_maintenance",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="189" HEIGHT="20">本地结果与队列</TD></TR><TR><TD WIDTH="189" HEIGHT="20">可靠保存、确认后清队列</TD></TR></TABLE>>];}
parent -> gateway [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="147" HEIGHT="20">1 任务与授权设置</TD></TR></TABLE>>];gateway -> session [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="147" HEIGHT="20">2 命令下发与确认</TD></TR></TABLE>>];camera -> session [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">有效动作事件</TD></TR></TABLE>>];session -> feedback [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="159" HEIGHT="20">当前状态与确认进度</TD></TR></TABLE>>];session -> local [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">保存真实结果</TD></TR></TABLE>>];local -> records [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="147" HEIGHT="20">3 补传结构化结果</TD></TR></TABLE>>];records -> parent [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="147" HEIGHT="20">4 返回已授权记录</TD></TR></TABLE>>,constraint=false];gateway -> records [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">权限校验</TD></TR></TABLE>>];}