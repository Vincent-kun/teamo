digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_algorithm_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="69" HEIGHT="20">无人</TD></TR><TR><TD WIDTH="69" HEIGHT="20">不开始</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_algorithm_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">身体不完整</TD></TR><TR><TD WIDTH="99" HEIGHT="20">手脚需可见</TD></TR></TABLE>>,];
n2 [id="node_algorithm_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">距离不合适</TD></TR><TR><TD WIDTH="114" HEIGHT="20">调整前后位置</TD></TR></TABLE>>,];
n3 [id="node_algorithm_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">稳定入镜</TD></TR><TR><TD WIDTH="84" HEIGHT="20">准备满足</TD></TR></TABLE>>,];
n4 [id="node_algorithm_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">周期进行中</TD></TR><TR><TD WIDTH="99" HEIGHT="20">半周期不计</TD></TR></TABLE>>,];
n5 [id="node_algorithm_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">有效事件</TD></TR><TR><TD WIDTH="129" HEIGHT="20">次数或有效秒数</TD></TR></TABLE>>,];
n6 [id="node_algorithm_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">置信度不足</TD></TR><TR><TD WIDTH="99" HEIGHT="20">不补造次数</TD></TR></TABLE>>,];
n7 [id="node_algorithm_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">算法故障</TD></TR><TR><TD WIDTH="129" HEIGHT="20">暂停与明确提示</TD></TR></TABLE>>,];
n8 [id="node_algorithm_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">模型切换</TD></TR><TR><TD WIDTH="129" HEIGHT="20">无活动会话校验</TD></TR></TABLE>>,penwidth=2,];n0 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">人体与站位满足</TD></TR></TABLE>>,id="edge_0_3_0",];
n1 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">身体完整</TD></TR></TABLE>>,id="edge_1_3_1",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">距离满足</TD></TR></TABLE>>,id="edge_2_3_2",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">启动运动</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">完整动作周期</TD></TR></TABLE>>,id="edge_4_5_4",];
n5 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">下一个周期</TD></TR></TABLE>>,id="edge_5_4_5",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n4 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">置信度不足</TD></TR></TABLE>>,id="edge_4_6_6",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n6 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">重新站位</TD></TR></TABLE>>,id="edge_6_3_7",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n4 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">算法故障</TD></TR></TABLE>>,id="edge_4_7_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n7 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="93" HEIGHT="20">修复/回滚</TD></TR></TABLE>>,id="edge_7_8_9",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];}