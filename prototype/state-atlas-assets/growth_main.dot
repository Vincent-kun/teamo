n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">去重发放</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">历史比较</TD></TR></TABLE>>,id="edge_4_5_4",];n0->n1 [style=invis,weight=10];
