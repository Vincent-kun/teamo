n5 [id="node_growth_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">个人进步</TD></TR><TR><TD WIDTH="99" HEIGHT="20">有可比依据</TD></TR></TABLE>>,penwidth=2,];


