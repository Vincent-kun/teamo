digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_analysis_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">无记录</TD></TR><TR><TD WIDTH="84" HEIGHT="20">数据不足</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_analysis_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">未授权</TD></TR><TR><TD WIDTH="99" HEIGHT="20">不发送摘要</TD></TR></TABLE>>,];
n2 [id="node_analysis_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">可请求</TD></TR><TR><TD WIDTH="129" HEIGHT="20">最小结构化数据</TD></TR></TABLE>>,];
n3 [id="node_analysis_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">请求中</TD></TR><TR><TD WIDTH="144" HEIGHT="20">可离开不阻塞运动</TD></TR></TABLE>>,];
n4 [id="node_analysis_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">分析完成</TD></TR><TR><TD WIDTH="129" HEIGHT="20">依据与局限可见</TD></TR></TABLE>>,];
n5 [id="node_analysis_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">规则降级</TD></TR><TR><TD WIDTH="129" HEIGHT="20">超时或内容拦截</TD></TR></TABLE>>,];
n6 [id="node_analysis_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">计划待审核</TD></TR><TR><TD WIDTH="144" HEIGHT="20">已支持动作与强度</TD></TR></TABLE>>,];
n7 [id="node_analysis_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">家长确认</TD></TR><TR><TD WIDTH="114" HEIGHT="20">目标解释清楚</TD></TR></TABLE>>,];
n8 [id="node_analysis_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">计划发送</TD></TR><TR><TD WIDTH="99" HEIGHT="20">走任务回执</TD></TR></TABLE>>,penwidth=2,];n0 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">真实数据足够</TD></TR></TABLE>>,id="edge_0_2_0",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">单独授权</TD></TR></TABLE>>,id="edge_1_2_1",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">发起请求</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">结构校验通过</TD></TR></TABLE>>,id="edge_3_4_3",];
n3 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="123" HEIGHT="20">失败/内容拦截</TD></TR></TABLE>>,id="edge_3_5_4",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n4 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">提出计划建议</TD></TR></TABLE>>,id="edge_4_6_5",];
n6 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">专业规则通过</TD></TR></TABLE>>,id="edge_6_7_6",];
n7 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">家长确认</TD></TR></TABLE>>,id="edge_7_8_7",];
n5 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="54" HEIGHT="20">重试</TD></TR></TABLE>>,id="edge_5_2_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];}