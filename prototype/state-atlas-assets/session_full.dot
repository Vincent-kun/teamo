digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_session_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">待机/选择</TD></TR><TR><TD WIDTH="129" HEIGHT="20">任务或自主运动</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_session_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">入镜</TD></TR><TR><TD WIDTH="144" HEIGHT="20">全身、距离与站位</TD></TR></TABLE>>,];
n2 [id="node_session_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">准备</TD></TR><TR><TD WIDTH="114" HEIGHT="20">稳定满足条件</TD></TR></TABLE>>,];
n3 [id="node_session_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">倒计时</TD></TR><TR><TD WIDTH="99" HEIGHT="20">离画可取消</TD></TR></TABLE>>,];
n4 [id="node_session_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="159" HEIGHT="20">运动中</TD></TR><TR><TD WIDTH="159" HEIGHT="20">确认次数或有效秒数</TD></TR></TABLE>>,];
n5 [id="node_session_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">暂停</TD></TR><TR><TD WIDTH="114" HEIGHT="20">保留确认进度</TD></TR></TABLE>>,];
n6 [id="node_session_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">结果待保存</TD></TR><TR><TD WIDTH="129" HEIGHT="20">达标或提前结束</TD></TR></TABLE>>,];
n7 [id="node_session_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">保存失败</TD></TR><TR><TD WIDTH="129" HEIGHT="20">进度保留可重试</TD></TR></TABLE>>,];
n8 [id="node_session_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="159" HEIGHT="20">结果</TD></TR><TR><TD WIDTH="159" HEIGHT="20">业务状态与同步分开</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">儿童选择</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">入镜稳定</TD></TR></TABLE>>,id="edge_1_2_1",];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">儿童确认</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">倒计时结束</TD></TR></TABLE>>,id="edge_3_4_3",];
n3 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="54" HEIGHT="20">离画</TD></TR></TABLE>>,id="edge_3_1_4",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="93" HEIGHT="20">暂停/离画</TD></TR></TABLE>>,id="edge_4_5_5",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n5 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">重新入镜且确认</TD></TR></TABLE>>,id="edge_5_4_6",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n4 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="93" HEIGHT="20">达标/结束</TD></TR></TABLE>>,id="edge_4_6_7",];
n5 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">提前结束</TD></TR></TABLE>>,id="edge_5_6_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n6 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">写入失败</TD></TR></TABLE>>,id="edge_6_7_9",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n7 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">重试保存成功</TD></TR></TABLE>>,id="edge_7_8_10",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n6 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">保存成功</TD></TR></TABLE>>,id="edge_6_8_11",];}