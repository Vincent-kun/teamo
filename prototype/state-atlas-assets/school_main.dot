digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_school_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">未关联</TD></TR><TR><TD WIDTH="129" HEIGHT="20">不共享家庭数据</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_school_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">邀请待确认</TD></TR><TR><TD WIDTH="114" HEIGHT="20">核验学校班级</TD></TR></TABLE>>,];
n2 [id="node_school_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">已授权</TD></TR><TR><TD WIDTH="114" HEIGHT="20">数据范围明确</TD></TR></TABLE>>,];
n3 [id="node_school_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">学校任务</TD></TR><TR><TD WIDTH="129" HEIGHT="20">支持动作与期限</TD></TR></TABLE>>,];
n4 [id="node_school_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">家庭执行</TD></TR><TR><TD WIDTH="114" HEIGHT="20">复用运动会话</TD></TR></TABLE>>,];
n5 [id="node_school_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">结果待回传</TD></TR><TR><TD WIDTH="129" HEIGHT="20">真实结果已保存</TD></TR></TABLE>>,];
n6 [id="node_school_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">必要结果已回传</TD></TR><TR><TD WIDTH="129" HEIGHT="20">无家庭视频</TD></TR></TABLE>>,penwidth=2,];

n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">学校邀请</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">家长核验确认</TD></TR></TABLE>>,id="edge_1_2_1",];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">发布任务</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">儿童选择开始</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">保存结果</TD></TR></TABLE>>,id="edge_4_5_4",];
n5 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">授权且结果同步</TD></TR></TABLE>>,id="edge_5_6_5",];n0->n1 [style=invis,weight=10];
n1->n2 [style=invis,weight=10];
n2->n3 [style=invis,weight=10];
n3->n4 [style=invis,weight=10];
