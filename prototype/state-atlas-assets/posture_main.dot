digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_posture_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">未开启</TD></TR><TR><TD WIDTH="84" HEIGHT="20">用途透明</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_posture_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">等待授权</TD></TR><TR><TD WIDTH="114" HEIGHT="20">家长明确开启</TD></TR></TABLE>>,];
n2 [id="node_posture_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">观察中</TD></TR><TR><TD WIDTH="99" HEIGHT="20">有人才判断</TD></TR></TABLE>>,];
n3 [id="node_posture_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">持续异常</TD></TR><TR><TD WIDTH="114" HEIGHT="20">过滤瞬时变化</TD></TR></TABLE>>,];
n4 [id="node_posture_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">提醒</TD></TR><TR><TD WIDTH="114" HEIGHT="20">一条温和提示</TD></TR></TABLE>>,];
n5 [id="node_posture_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">冷却中</TD></TR><TR><TD WIDTH="84" HEIGHT="20">抑制重复</TD></TR></TABLE>>,penwidth=2,];


n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">家长选择</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="129" HEIGHT="20">授权且物理开启</TD></TR></TABLE>>,id="edge_1_2_1",];
n2 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">持续异常</TD></TR></TABLE>>,id="edge_2_3_2",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">阈值满足</TD></TR></TABLE>>,id="edge_3_4_3",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="69" HEIGHT="20">提醒后</TD></TR></TABLE>>,id="edge_4_5_4",];
n5 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">冷却结束</TD></TR></TABLE>>,id="edge_5_2_5",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];n0->n1 [style=invis,weight=10];
n1->n2 [style=invis,weight=10];
n2->n3 [style=invis,weight=10];
n3->n4 [style=invis,weight=10];
n4->n5 [style=invis,weight=10];}