digraph {graph [bgcolor="transparent",fontname="Microsoft YaHei",fontsize=15,nodesep=.45,ranksep=.60,pad=.25,splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#f2ecfc",color="#d9cfea",fontcolor="#352b48",fontname="Microsoft YaHei",fontsize=15,margin=".18,.14",penwidth=1.2]; edge [color="#8e839d",fontcolor="#655b76",fontname="Microsoft YaHei",fontsize=12,arrowsize=.65,penwidth=1.1]; rankdir=TB;n0 [id="node_binding_0",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="144" HEIGHT="20">未登录</TD></TR><TR><TD WIDTH="144" HEIGHT="20">儿童数据不可访问</TD></TR></TABLE>>,fillcolor="#e8f3ee",color="#adcdbc",];
n1 [id="node_binding_1",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">登录中</TD></TR><TR><TD WIDTH="114" HEIGHT="20">验证家长身份</TD></TR></TABLE>>,];
n2 [id="node_binding_2",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">登录失败</TD></TR><TR><TD WIDTH="99" HEIGHT="20">重试或退出</TD></TR></TABLE>>,];
n3 [id="node_binding_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">已登录未绑定</TD></TR><TR><TD WIDTH="114" HEIGHT="20">最小儿童档案</TD></TR></TABLE>>,];
n4 [id="node_binding_4",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">设备发现</TD></TR><TR><TD WIDTH="99" HEIGHT="20">扫码或配网</TD></TR></TABLE>>,];
n5 [id="node_binding_5",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">等待设备确认</TD></TR><TR><TD WIDTH="114" HEIGHT="20">证明归属</TD></TR></TABLE>>,];
n6 [id="node_binding_6",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">绑定成功</TD></TR><TR><TD WIDTH="84" HEIGHT="20">权限有效</TD></TR></TABLE>>,];
n7 [id="node_binding_7",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="138" HEIGHT="20">绑定冲突</TD></TR><TR><TD WIDTH="138" HEIGHT="20">已有归属/码过期</TD></TR></TABLE>>,];
n8 [id="node_binding_8",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">解绑/撤权</TD></TR><TR><TD WIDTH="99" HEIGHT="20">旧令牌失效</TD></TR></TABLE>>,penwidth=2,];n0 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">家长登录</TD></TR></TABLE>>,id="edge_0_1_0",];
n1 -> n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">验证失败</TD></TR></TABLE>>,id="edge_1_2_1",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n2 -> n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="54" HEIGHT="20">重试</TD></TR></TABLE>>,id="edge_2_1_2",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n1 -> n3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">登录成功</TD></TR></TABLE>>,id="edge_1_3_3",];
n3 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">添加设备</TD></TR></TABLE>>,id="edge_3_4_4",];
n4 -> n5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">提交绑定</TD></TR></TABLE>>,id="edge_4_5_5",];
n5 -> n6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">归属核验成功</TD></TR></TABLE>>,id="edge_5_6_6",];
n5 -> n7 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="114" HEIGHT="20">归属核验失败</TD></TR></TABLE>>,id="edge_5_7_7",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];
n7 -> n4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">重新发现</TD></TR></TABLE>>,id="edge_7_4_8",color="#b57932",fontcolor="#976120",style=dashed,constraint=false,];
n6 -> n8 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="84" HEIGHT="20">确认解绑</TD></TR></TABLE>>,id="edge_6_8_9",color="#b57932",fontcolor="#976120",style=dashed,constraint=true,];}