n3 [id="node_sync_3",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="99" HEIGHT="20">待上传</TD></TR><TR><TD WIDTH="99" HEIGHT="20">已可靠保存</TD></TR></TABLE>>,];
