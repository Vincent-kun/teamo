.profile-form{margin-top:30rpx;padding:30rpx;border-radius:38rpx;background:#fff;box-shadow:0 18rpx 45rpx rgba(54,70,68,.08)}.avatar{width:110rpx;height:110rpx;border-radius:38rpx;margin:0 auto 20rpx;background:linear-gradient(135deg,#f7d3e8,#dedcf8);display:grid;place-items:center;color:#0e5662;font-size:42rpx;font-weight:900}.stepper{display:flex;align-items:center;justify-content:center;gap:38rpx}.stepper button{width:68rpx;height:68rpx;border-radius:22rpx;background:#edf6f5}.stepper text{font-size:38rpx;font-weight:850}.save{width:100%;margin-top:34rpx}.privacy{text-align:center;color:#8a928e;font-size:21rpx;line-height:1.6;padding:28rpx 18rpx}
.profile-form{background:linear-gradient(145deg,rgba(255,255,255,.7),rgba(232,244,244,.4));border:1rpx solid rgba(255,255,255,.88);box-shadow:inset 0 1rpx 0 #fff,0 22rpx 50rpx rgba(54,70,68,.1);-webkit-backdrop-filter:blur(30rpx) saturate(145%);backdrop-filter:blur(30rpx) saturate(145%)}.avatar{background:linear-gradient(135deg,rgba(255,255,255,.7),rgba(222,220,248,.52));border:1rpx solid rgba(255,255,255,.88);box-shadow:inset 0 1rpx 0 #fff,0 14rpx 32rpx rgba(72,67,92,.08)}.stepper button{background:rgba(255,255,255,.56);border:1rpx solid rgba(255,255,255,.8)}
