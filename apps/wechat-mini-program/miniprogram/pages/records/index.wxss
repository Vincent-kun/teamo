.record-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:30rpx}.record-summary view{padding:24rpx 8rpx;text-align:center;border-radius:28rpx;background:#f7d3e8}.record-summary view:nth-child(2){background:#dedcf8}.record-summary view:nth-child(3){background:#d8eef1}.record-summary text{display:block;font-size:20rpx;color:#707874}.record-summary text:first-child{font-size:36rpx;font-weight:900;color:#111816;margin-bottom:4rpx}.record-list{overflow:hidden;border-radius:34rpx;background:#fff}.record-item{display:flex;align-items:center;gap:18rpx;padding:24rpx;border-bottom:1rpx solid #e9e5dd}.record-item:last-child{border:0}.score{width:68rpx;height:68rpx;border-radius:22rpx;background:#0e5662;color:#c8fb37;display:grid;place-items:center;font-weight:900}
.record-title{display:flex;align-items:center;gap:10rpx}.record-status{padding:4rpx 9rpx;border-radius:99rpx;font-size:17rpx}.record-status.done{background:#eaf8f1;color:#16815e}.record-status.warn{background:#fff0ee;color:#a44242}.source{font-size:19rpx;color:#8a918e;margin-top:6rpx}
.record-summary view{background:rgba(247,211,232,.38);border:1rpx solid rgba(255,255,255,.68);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.record-summary view:nth-child(2){background:rgba(222,220,248,.42)}.record-summary view:nth-child(3){background:rgba(216,238,241,.46)}.record-list{background:rgba(255,255,255,.58);border:1rpx solid rgba(255,255,255,.84);box-shadow:inset 0 1rpx 0 #fff,0 16rpx 38rpx rgba(54,70,68,.075);-webkit-backdrop-filter:blur(26rpx);backdrop-filter:blur(26rpx)}
