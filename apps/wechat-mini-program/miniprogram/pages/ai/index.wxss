.ai-head { display:flex; gap:20rpx; align-items:center; margin-bottom:30rpx; }
.orb { width:90rpx; height:90rpx; border-radius:30rpx; background:#0e5662; color:#fff; display:grid; place-items:center; font-weight:900; box-shadow:0 16rpx 30rpx rgba(14,86,98,.16); }
.builder { padding:28rpx; background:linear-gradient(145deg,#fff,#eef7f7); }
.stepper { display:flex; align-items:center; justify-content:center; gap:42rpx; }
.stepper button { width:68rpx; height:68rpx; border-radius:50%; background:#eeece5; }
.stepper text { font-size:42rpx; font-weight:800; }
.generate { width:100%; margin-top:34rpx; }
.plan-hero { color:#fff; border-radius:38rpx; padding:34rpx; background:#0e5662; box-shadow:0 20rpx 40rpx rgba(14,86,98,.18); }
.plan-title { font-size:38rpx; font-weight:850; margin:10rpx 0; }
.day { width:62rpx; height:62rpx; border-radius:20rpx; display:grid; place-items:center; color:#473f6a; background:#dedcf8; font-weight:800; }
.day-list .strong + .strong { margin-top:8rpx; }
.actions { display:grid; grid-template-columns:1fr 1.4fr; gap:14rpx; margin-top:22rpx; }
.ask-card { padding:26rpx; }
.ask-title { display:flex; align-items:center; gap:16rpx; }
.mini-orb { width:54rpx; height:54rpx; border-radius:18rpx; background:#f7d3e8; color:#744a65; display:grid; place-items:center; font-weight:900; }
.quick-questions { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:22rpx; }
.quick-questions button { margin:0; padding:14rpx 18rpx; border-radius:999rpx; background:#dedcf8; color:#353b38; font-size:22rpx; line-height:1.2; }
.quick-questions button:nth-child(2) { background:#d8eef1; }
.quick-questions button:nth-child(3) { background:#f7d3e8; }
.ai-answer { margin-top:20rpx; padding:22rpx; border-radius:24rpx; background:#effbcf; color:#293129; font-size:24rpx; line-height:1.7; }
.ai-answer text { display:block; color:#59620a; font-size:20rpx; font-weight:850; margin-bottom:6rpx; }
.ai-note { color:#8a9692; text-align:center; font-size:21rpx; line-height:1.6; padding:30rpx 20rpx; }
.ask-input{display:flex;gap:10rpx;margin-top:18rpx;padding:8rpx;border-radius:24rpx;background:#f4f5f2}.ask-input input{flex:1;padding:12rpx 16rpx;font-size:23rpx}.ask-input button{margin:0;padding:13rpx 20rpx;border-radius:18rpx;background:#0e5662;color:#fff;font-size:22rpx;line-height:1.2}.history-card{display:flex;align-items:center;gap:18rpx;padding:24rpx;border-radius:30rpx;background:#ffe3d2}.history-mark{width:60rpx;height:60rpx;border-radius:20rpx;background:#fff;display:grid;place-items:center;font-weight:900;color:#a25e35}
.insight-entry{display:flex;align-items:center;gap:18rpx;padding:24rpx;border-radius:30rpx;background:#0e5662;color:#fff;margin-bottom:24rpx}.insight-score{width:58rpx;height:58rpx;border-radius:18rpx;background:#c8fb37;color:#111816;display:grid;place-items:center;font-weight:900}.module-title{display:flex;justify-content:space-between;align-items:center;margin:24rpx 4rpx 16rpx}.beta{padding:7rpx 12rpx;border-radius:99rpx;background:#ffe3d2;color:#985b37;font-size:19rpx;font-weight:800}

/* Acrylic material layer */
.orb{background:linear-gradient(145deg,rgba(14,86,98,.96),rgba(23,109,119,.78));border:1rpx solid rgba(255,255,255,.22);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.22),0 18rpx 36rpx rgba(14,86,98,.16)}
.builder,.ask-card{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(232,244,244,.42));border:1rpx solid rgba(255,255,255,.86);box-shadow:inset 0 1rpx 0 #fff,0 18rpx 40rpx rgba(54,70,68,.08);-webkit-backdrop-filter:blur(28rpx) saturate(145%);backdrop-filter:blur(28rpx) saturate(145%)}
.insight-entry,.plan-hero{background:linear-gradient(145deg,rgba(10,68,78,.96),rgba(19,101,112,.8));border:1rpx solid rgba(255,255,255,.18);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.18),0 20rpx 44rpx rgba(14,86,98,.17)}
.quick-questions button,.quick-questions button:nth-child(2),.quick-questions button:nth-child(3){background:rgba(255,255,255,.52);border:1rpx solid rgba(255,255,255,.78)}
.ai-answer,.history-card{background:linear-gradient(145deg,rgba(255,255,255,.6),rgba(239,251,207,.45));border:1rpx solid rgba(255,255,255,.75);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}
.ask-input{background:rgba(255,255,255,.48);border:1rpx solid rgba(255,255,255,.74)}
