.device-page { padding-top:28rpx; }
.device-heading { margin-bottom:28rpx; }
.device-shell { width:500rpx; margin:0 auto 28rpx; padding:70rpx 28rpx 20rpx; border-radius:108rpx 108rpx 74rpx 74rpx; background:linear-gradient(145deg,#fff,#e0eff0); border:1rpx solid #d2e4e5; box-shadow:0 34rpx 70rpx rgba(51,78,79,.17); position:relative; }
.privacy-track { position:absolute; top:25rpx; left:164rpx; width:172rpx; height:28rpx; border-radius:99rpx; background:#161c1b; box-shadow:inset 0 2rpx 6rpx rgba(0,0,0,.65); }
.privacy-knob { position:absolute; right:3rpx; top:3rpx; width:54rpx; height:22rpx; border-radius:99rpx; background:#ff7734; }
.camera { width:22rpx; height:22rpx; border-radius:50%; background:#050a09; position:absolute; top:28rpx; left:239rpx; box-shadow:0 0 0 5rpx #565c59; }
.screen { height:470rpx; border:8rpx solid #303735; border-radius:50%; background:radial-gradient(circle at 50% 30%,#26312f,#070b0b 66%); color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:54rpx; text-align:center; box-shadow:inset 0 0 45rpx rgba(255,255,255,.04); }
.eyes { display:flex; gap:76rpx; margin-bottom:55rpx; }
.eyes .eye { width:28rpx; height:76rpx; border-radius:18rpx; background:#f8f9f1; box-shadow:0 0 18rpx rgba(255,255,255,.5); }
.eyes.happy .eye { width:76rpx; height:38rpx; background:transparent; box-shadow:none; border:0; border-bottom:10rpx solid #f8f9f1; border-radius:0 0 80rpx 80rpx; }
.screen-title { font-size:38rpx; font-weight:850; }
.screen-copy,.screen-kicker { color:#a9beb8; font-size:24rpx; margin-top:18rpx; }
.big-count { font-size:130rpx; font-weight:900; line-height:1; margin:35rpx 0; }
.big-count text { font-size:34rpx; color:#9eb6af; }
.device-progress { width:85%; height:14rpx; border-radius:99rpx; background:#1b3a34; overflow:hidden; }
.device-progress view { height:100%; background:#c8fb37; }
.device-base { width:180rpx; height:16rpx; border-radius:99rpx; background:#bbc9c3; margin:20rpx auto 0; }
.privacy-tip { display:flex; align-items:center; gap:18rpx; padding:20rpx 24rpx; border-radius:30rpx; background:#ffe3d2; border:1rpx solid #f3cfb9; margin-bottom:20rpx; }
.shield { width:50rpx; height:50rpx; border-radius:18rpx; background:#ff7734; color:#fff; display:grid; place-items:center; font-weight:900; }
.status-card { margin-top:24rpx; }
.device-meta { display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; margin-top:24rpx; }
.device-meta view { background:#f7d3e8; border-radius:22rpx; padding:18rpx 8rpx; text-align:center; }
.device-meta view:nth-child(2) { background:#dedcf8; }
.device-meta view:nth-child(3) { background:#d8eef1; }
.device-meta text { display:block; font-size:22rpx; font-weight:750; }
.device-meta text + text { margin-top:4rpx; color:#7d827f; font-size:19rpx; font-weight:500; }
.controls { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:20rpx; }
.feature-list .list-item{padding:22rpx}.timeline{padding:6rpx 24rpx;border-radius:32rpx;background:#fff}.timeline-item{display:flex;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #e9e5dd}.timeline-item:last-child{border:0}.timeline-dot{width:18rpx;height:18rpx;margin-top:7rpx;border-radius:50%;background:#c8fb37;box-shadow:0 0 0 7rpx #effbcf}
.current-task{margin-top:18rpx;padding:18rpx;border-radius:22rpx;background:#edf6f5}.sync{padding:7rpx 12rpx;border-radius:99rpx;background:#eaf8f1;color:#16815e;font-size:19rpx;font-weight:800}

/* Acrylic material layer */
.device-shell{background:linear-gradient(145deg,rgba(255,255,255,.82),rgba(211,232,235,.52));border-color:rgba(255,255,255,.92);box-shadow:inset 0 2rpx 1rpx rgba(255,255,255,.95),inset -10rpx -12rpx 28rpx rgba(127,158,159,.12),0 38rpx 76rpx rgba(45,72,73,.17);-webkit-backdrop-filter:blur(30rpx) saturate(145%);backdrop-filter:blur(30rpx) saturate(145%)}
.privacy-tip{background:linear-gradient(145deg,rgba(255,255,255,.62),rgba(255,227,210,.46));border-color:rgba(255,255,255,.8);box-shadow:inset 0 1rpx 0 #fff,0 12rpx 30rpx rgba(84,67,55,.06)}
.device-meta view{background:rgba(247,211,232,.34);border:1rpx solid rgba(255,255,255,.62)}.device-meta view:nth-child(2){background:rgba(222,220,248,.38)}.device-meta view:nth-child(3){background:rgba(216,238,241,.42)}
.current-task{background:rgba(237,246,245,.58);border:1rpx solid rgba(255,255,255,.68)}
.timeline{background:rgba(255,255,255,.56);border:1rpx solid rgba(255,255,255,.82);box-shadow:inset 0 1rpx 0 #fff,0 14rpx 34rpx rgba(54,70,68,.07);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx)}
