.library-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:30rpx; }
.move-card { min-height:210rpx; padding:24rpx; border-radius:32rpx; background:#fff; box-shadow:0 15rpx 35rpx rgba(54,70,68,.06); }
.move-card.pink{background:#f7d3e8}.move-card.purple{background:#dedcf8}.move-card.blue{background:#d8eef1}.move-card.peach{background:#ffe3d2}.move-card.mint{background:#effbcf}
.symbol { width:62rpx; height:62rpx; border-radius:20rpx; display:grid; place-items:center; background:rgba(255,255,255,.82); font-weight:900; margin-bottom:18rpx; }
.move-top{display:flex;justify-content:space-between;align-items:flex-start}.stage{padding:7rpx 10rpx;border-radius:99rpx;background:rgba(255,255,255,.72);font-size:17rpx;color:#727875}.stage.ready{background:#0e5662;color:#fff}.move-card.unavailable{opacity:.76}
.target-label { display:inline-block; margin-top:16rpx; padding:7rpx 12rpx; border-radius:99rpx; background:rgba(255,255,255,.65); font-size:20rpx; font-weight:750; }
.detail-card { margin-top:22rpx; padding:28rpx; border-radius:36rpx; background:#fff; box-shadow:0 18rpx 45rpx rgba(54,70,68,.10); }
.detail-head { display:flex; justify-content:space-between; align-items:center; }.detail-head>text{font-size:44rpx;color:#8a918e}.detail-title{font-size:36rpx;font-weight:850}
.guide { margin-top:22rpx; line-height:1.75; color:#46504d; }.hint{margin-top:18rpx;padding:20rpx;border-radius:24rpx;background:#d8eef1;line-height:1.6}.hint text{display:block;font-size:20rpx;font-weight:850;color:#0e5662}
.stepper { display:flex; align-items:center; justify-content:center; gap:40rpx; }.stepper button{width:70rpx;height:70rpx;border-radius:22rpx;background:#edf6f5}.stepper view{font-size:52rpx;font-weight:900}.stepper text{font-size:24rpx;margin-left:6rpx;color:#7b817d}.full{width:100%;margin-top:26rpx}
.btn-disabled{background:#e5e8e5;color:#7d837f}

/* Acrylic material layer */
.move-card,.move-card.pink,.move-card.purple,.move-card.blue,.move-card.peach,.move-card.mint{background:linear-gradient(145deg,rgba(255,255,255,.66),rgba(255,255,255,.36));border:1rpx solid rgba(255,255,255,.86);box-shadow:inset 0 1rpx 0 #fff,0 16rpx 38rpx rgba(54,70,68,.08);-webkit-backdrop-filter:blur(26rpx) saturate(145%);backdrop-filter:blur(26rpx) saturate(145%)}
.move-card.pink{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(247,211,232,.44))}.move-card.purple{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(222,220,248,.48))}.move-card.blue{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(216,238,241,.48))}.move-card.peach{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(255,227,210,.46))}.move-card.mint{background:linear-gradient(145deg,rgba(255,255,255,.68),rgba(239,251,207,.45))}
.detail-card{background:rgba(255,255,255,.64);border:1rpx solid rgba(255,255,255,.88);box-shadow:inset 0 1rpx 0 #fff,0 22rpx 50rpx rgba(54,70,68,.1);-webkit-backdrop-filter:blur(30rpx) saturate(145%);backdrop-filter:blur(30rpx) saturate(145%)}
.hint{background:rgba(216,238,241,.48);border:1rpx solid rgba(255,255,255,.68)}
