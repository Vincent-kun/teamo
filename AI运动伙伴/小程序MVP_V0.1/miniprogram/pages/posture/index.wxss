.posture-hero{display:flex;align-items:center;gap:22rpx;margin-top:30rpx;padding:28rpx;border-radius:36rpx;background:#0e5662;color:#fff}.number{width:88rpx;height:88rpx;border-radius:28rpx;background:#c8fb37;color:#111816;display:grid;place-items:center;font-size:42rpx;font-weight:900}.care-grid{display:grid;gap:14rpx}.care-card{padding:26rpx;border-radius:32rpx;display:grid;grid-template-columns:64rpx 1fr;column-gap:18rpx;align-items:center}.care-card .small{grid-column:2;line-height:1.55}.pink{background:#f7d3e8}.purple{background:#dedcf8}.blue{background:#d8eef1}.icon{grid-row:1/3;width:64rpx;height:64rpx;border-radius:20rpx;background:rgba(255,255,255,.75);display:grid;place-items:center;font-weight:900}.principles view{line-height:2;color:#48524f}.notice{margin-top:22rpx;padding:22rpx;border-radius:24rpx;background:#ffe3d2;color:#7a553e;font-size:22rpx;line-height:1.6}
.posture-hero{background:linear-gradient(145deg,rgba(10,68,78,.96),rgba(19,101,112,.8));border:1rpx solid rgba(255,255,255,.18);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.18),0 20rpx 44rpx rgba(14,86,98,.16)}.care-card{border:1rpx solid rgba(255,255,255,.8);box-shadow:inset 0 1rpx 0 #fff,0 14rpx 34rpx rgba(54,70,68,.07);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx)}.care-card.pink{background:linear-gradient(145deg,rgba(255,255,255,.64),rgba(247,211,232,.44))}.care-card.purple{background:linear-gradient(145deg,rgba(255,255,255,.64),rgba(222,220,248,.46))}.care-card.blue{background:linear-gradient(145deg,rgba(255,255,255,.64),rgba(216,238,241,.48))}.notice{background:linear-gradient(145deg,rgba(255,255,255,.58),rgba(255,227,210,.45));border:1rpx solid rgba(255,255,255,.76)}
