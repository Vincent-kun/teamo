<view class="page"><view class="brand-kicker">MOVE HISTORY <text>PROGRESS</text></view><view class="hero-title">运动记录</view><view class="hero-sub">每一次完成，都值得被看见</view>
<view class="record-summary"><view><text>{{total}}</text><text>累计记录</text></view><view><text>{{average}}</text><text>平均得分</text></view><view><text>{{records[0].valid || 0}}</text><text>最近有效动作</text></view></view>
<view class="section-title">全部记录</view><view class="record-list"><view class="record-item" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord"><view class="score">{{item.score}}</view><view class="grow"><view class="record-title"><view class="strong">{{item.name}}</view><view class="record-status {{item.status==='已完成'?'done':'warn'}}">{{item.status}}</view></view><view class="small muted">{{item.date}} · {{item.actual}}/{{item.target}} · {{item.duration}}秒</view><view class="source">{{item.source}} · {{item.deviceName}}</view></view><text>›</text></view><view class="empty" wx:if="{{records.length===0}}">完成第一次运动后，记录会出现在这里</view></view></view>
